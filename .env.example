# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=freerouter
DB_PASSWORD=freerouter
DB_NAME=freerouter
DB_SSLMODE=disable

# ── Redis ────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Response Cache ───────────────────────────────────────────────────
# Caches non-streaming chat completion responses in Redis, scoped per
# authenticated subject. Invalidate via DELETE /api/v1/gateway/cache.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# ── Metrics ──────────────────────────────────────────────────────────
# Exposes Prometheus metrics at GET /metrics when enabled.
METRICS_ENABLED=true

# ── Encryption ───────────────────────────────────────────────────────
# 32-byte hex key for provider key encryption (NaCl secretbox)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── IAMKit ───────────────────────────────────────────────────────────
# `make bootstrap` fills the empty ids and IAMKIT_SERVICE_SECRET.
IAMKIT_BASE_URL=http://localhost:8080
IAMKIT_JWT_ISSUER=http://localhost:8080
# FreeRouter resource audience (default: http://localhost:$SERVER_PORT)
IAMKIT_AUDIENCE=
IAMKIT_ENVIRONMENT_ID=
IAMKIT_APPLICATION_ID=
IAMKIT_RESOURCE_ID=
# Organization FreeRouter users and role assignments live in
IAMKIT_ORGANIZATION_ID=
# FreeRouter's backend service account (ik_svc_) on the environment's IAM
# resource, holding only iam:users/roles/service-accounts/apps:read (see
# scripts/permissions.sh). Enables /api/v1/access and /api/v1/service-accounts.
# Management keys (ik_mgmt_) are rejected at startup.
IAMKIT_SERVICE_SECRET=

# ── IAMKit Docker ────────────────────────────────────────────────────
# Source tree the iamkit image is built from (must match the SDK in go.mod)
IAMKIT_SRC=../iam
IAMKIT_DB_PASSWORD=iamkit_secret
IAMKIT_PORT=8080
# Generated by make setup: openssl rand -hex 32
OIDC_HMAC_SECRET=
# Seals secrets at rest in IAMKit; generated by make setup: openssl rand -base64 32
IAMKIT_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Workspace owner created by make bootstrap (iamkit bootstrap CLI)
IAMKIT_OPERATOR_EMAIL=admin@freerouter.dev
# Optional: make bootstrap creates this user with every freerouter
# permission, to sign in to the web console (password 12-72 bytes)
FREEROUTER_ADMIN_EMAIL=
FREEROUTER_ADMIN_PASSWORD=
