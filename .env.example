# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=freerouter
DB_PASSWORD=freerouter
DB_NAME=freerouter
DB_SSLMODE=disable

# ── Redis ────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Response Cache ───────────────────────────────────────────────────
# Caches non-streaming chat completion responses in Redis, scoped per
# authenticated subject. Invalidate via DELETE /api/v1/gateway/cache.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# ── Metrics ──────────────────────────────────────────────────────────
# Exposes Prometheus metrics at GET /metrics when enabled.
METRICS_ENABLED=true

# ── Encryption ───────────────────────────────────────────────────────
# 32-byte hex key for provider key encryption (NaCl secretbox)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── IAMKit ───────────────────────────────────────────────────────────
IAMKIT_BASE_URL=http://localhost:8080
IAMKIT_MANAGEMENT_KEY=ik_mgmt_...          # from: make iamkit-logs
IAMKIT_ENVIRONMENT_ID=                      # create via IAMKit management API
IAMKIT_APPLICATION_ID=                      # create via IAMKit management API
IAMKIT_RESOURCE_ID=                         # create via IAMKit management API
IAMKIT_JWT_ISSUER=http://localhost:8080
IAMKIT_AUDIENCE=

# ── IAMKit Docker ────────────────────────────────────────────────────
IAMKIT_DB_PASSWORD=iamkit_secret
IAMKIT_PORT=8080
OIDC_HMAC_SECRET=change-me-to-something-at-least-32-bytes
IAMKIT_BOOTSTRAP_EMAIL=admin@freerouter.dev
IAMKIT_BOOTSTRAP_PASSWORD=change-me-in-production
IAMKIT_BOOTSTRAP_WORKSPACE=FreeRouter
