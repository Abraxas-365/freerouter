# FreeRouter API base URL. Leave empty to call it on the console's own origin:
# `npm run dev` proxies /api and /v1 to http://localhost:3000, and in
# production serve the console and the API under one host. Required for
# FREEROUTER_AUTH=token, whose session cookie is same-origin only.
VITE_API_URL=

# IAMKit settings are served by the server (GET /api/v1/config, from its
# IAMKIT_* / IAMKIT_PUBLIC_URL). These VITE_IAMKIT_* values are only a
# fallback for a server that doesn't send them.
# VITE_IAMKIT_URL=http://localhost:8080
# VITE_IAMKIT_ENVIRONMENT_ID=
# VITE_IAMKIT_ORGANIZATION_ID=
# VITE_IAMKIT_APPLICATION_ID=
# VITE_IAMKIT_RESOURCE_ID=
# VITE_IAMKIT_AUDIENCE=
