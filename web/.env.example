VITE_API_URL=http://localhost:3000

# IAMKit sidecar — the console talks to it directly for login/refresh/logout.
VITE_IAMKIT_URL=http://localhost:8080

# Login boundary — must match the values configured in the server's .env
# (IAMKIT_ENVIRONMENT_ID/IAMKIT_APPLICATION_ID/IAMKIT_RESOURCE_ID) plus the
# organization the signing-in user belongs to. See IAMKit's
# docs/guides/password-login.md and docs/start/first-application.md.
VITE_IAMKIT_ENVIRONMENT_ID=
VITE_IAMKIT_ORGANIZATION_ID=
VITE_IAMKIT_APPLICATION_ID=
VITE_IAMKIT_RESOURCE_ID=
VITE_IAMKIT_AUDIENCE=
